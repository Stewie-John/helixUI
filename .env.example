# HelixUI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'helix-ui status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   helix-ui          - Start the server (default)
#   helix-ui start    - Start the server
#   helix-ui status   - Show configuration and data locations
#   helix-ui help     - Show help information
#   helix-ui version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to. Localhost is the secure default.
# Use 0.0.0.0 only behind a firewall or authenticated HTTPS reverse proxy.
HOST=127.0.0.1

# Reverse-proxy hardening. For cloudflared running on this same host, use
# TRUST_PROXY=loopback and set the one public hostname users will visit.
# Never use a broad proxy trust mode on an internet-facing listener.
# TRUST_PROXY=loopback
# ALLOWED_HOSTS=helix.example.com
# ENABLE_HSTS=true

# Public hostname used only when local HTTPS certificate files are configured.
# HTTPS_PUBLIC_HOST=localhost
# HTTPS_PORT=3443
# HTTPS_CERT_DIR=/absolute/path/to/private/certificates

# Persistent runtime data. Keep this outside the source checkout.
# CLOUDCLI_DATA_DIR=/home/you/.cloudcli
# CLOUDCLI_LOG_FILE=/home/you/.cloudcli/server.log

# File browser, uploads, shells, and new projects are restricted to this root.
# The default is ~/CloudCLIWorkspaces and is created automatically.
# WORKSPACES_ROOT=/home/you/CloudCLIWorkspaces

# JWT secret used to sign login tokens
# If omitted, a local random secret is generated under CLOUDCLI_DATA_DIR.
# Set explicitly for production, multi-instance, or ephemeral deployments.
# Generate with: openssl rand -hex 32
# JWT_SECRET=replace_with_a_long_random_secret

# Token lifetime for login JWTs
JWT_EXPIRES_IN=7d

# Encrypts stored service credentials (GitHub tokens, etc.)
# If omitted, a local random key is generated under CLOUDCLI_DATA_DIR.
# Set explicitly for production, multi-instance, or ephemeral deployments.
# Generate with: openssl rand -hex 32
# CREDENTIALS_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Login/register rate limit controls
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Additional application accounts are disabled by default. Enable only for a
# trusted team that intentionally shares the same OS account and workspaces.
# ENABLE_MULTI_USER=true

# Maximum accepted WebSocket frame/message size in MiB (1-128).
# 32 MiB leaves room for image prompts while bounding memory use per client.
WS_MAX_PAYLOAD_MB=32

# Codex app-server resilience and warm-process pool.
CODEX_APP_SERVER_TIMEOUT_MS=30000
CODEX_APP_SERVER_IDLE_MS=600000
CODEX_APP_SERVER_POOL_MAX=8

# Optional comma-separated CORS allowlist for browser clients
# Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com
# If unset, cross-origin browser requests are blocked.
# CORS_ORIGIN=

# Browser WebSockets are same-origin by default. Add trusted public origins only
# when a reverse proxy exposes a different origin.
# WS_ALLOWED_ORIGINS=https://app.example.com
# Non-browser WebSocket clients omit Origin. Keep disabled unless required.
WS_ALLOW_NO_ORIGIN=false
# Public health checks expose only status and time by default.
HEALTH_DETAILS=false

# Disabled by default because it lets an authenticated admin run update commands
# on the server (git pull/npm install or global npm update).
# ENABLE_SELF_UPDATE=true

# Only set with VITE_IS_PLATFORM=true when a trusted reverse proxy handles auth.
# TRUST_PROXY_AUTH=true

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# Codex/GPT context window size. GPT-5.6 Sol/Terra/Luna use 1,050,000 tokens.
VITE_CODEX_CONTEXT_WINDOW=1050000
CODEX_CONTEXT_WINDOW=1050000

# VITE_IS_PLATFORM=false
