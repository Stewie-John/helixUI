{
  "name": "@stewiejohn/helixui",
  "version": "1.0.0-rc.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "A self-hosted web workspace for Claude Code, OpenAI Codex, Cursor, Gemini, and compatible AI coding agents",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "helix-ui": "server/cli.js",
    "helixui": "server/cli.js"
  },
  "files": [
    "server/",
    "shared/",
    "dist/",
    "scripts/fix-node-pty.js",
    "README.md",
    "README.zh-CN.md",
    "docs/assets/"
  ],
  "homepage": "https://github.com/StewartJohn0/helixui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StewartJohn0/helixui.git"
  },
  "bugs": {
    "url": "https://github.com/StewartJohn0/helixui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "node scripts/dev-supervisor.js",
    "dev:daemon": "node scripts/dev-daemon.js start",
    "dev:stop": "node scripts/dev-daemon.js stop",
    "dev:status": "node scripts/dev-daemon.js status",
    "server": "node server/index.js",
    "client": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:stability": "node --test test/stability-protocol.test.mjs",
    "test:security": "node --test test/security-boundaries.test.mjs",
    "test:package": "node scripts/test-package-install.mjs",
    "privacy:check": "node scripts/check-public-release.mjs",
    "verify": "npm run privacy:check && npm run test:stability && npm run test:security && npm run typecheck && npm run build",
    "release:check": "npm run verify && npm run test:package && npm audit --omit=dev --audit-level=moderate",
    "start": "npm run build && npm run server",
    "release": "./scripts/release.mjs",
    "release:dry": "./scripts/release.mjs --dry-run",
    "publish:source": "npm run release:check && git push --set-upstream origin main --follow-tags",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "keywords": [
    "claude code",
    "codex",
    "coding agent",
    "self-hosted",
    "ai",
    "anthropic",
    "openai",
    "ui",
    "mobile",
    "helix",
    "custom providers",
    "terminal",
    "openai-compatible"
  ],
  "author": "Stewart John",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.85",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/merge": "^6.11.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@iarna/toml": "^2.2.5",
    "@octokit/rest": "^22.0.0",
    "@openai/codex": "^0.137.0",
    "@openai/codex-sdk": "^0.134.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/typography": "^0.5.16",
    "@uiw/react-codemirror": "^4.23.13",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "canvas": "^3.2.3",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.25",
    "lucide-react": "^0.515.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.1.0-beta34",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-error-boundary": "^4.1.2",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.14.2"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "tar": "^7.5.21"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/node": "^22.19.7",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.6.0",
    "auto-changelog": "^2.5.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "node-gyp": "^10.0.0",
    "postcss": "^8.4.32",
    "release-it": "^19.0.5",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.1.0",
    "vite-plugin-compression": "^0.5.1"
  }
}
